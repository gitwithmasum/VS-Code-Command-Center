{
  "name": "masum-galaxy-command-center",
  "displayName": "Masum Galaxy // Command Center",
  "description": "A futuristic VS Code developer command center with project launching, Git insights, quick actions, terminal controls, theme switching, workspace health, and productivity tools.",
  "version": "1.5.0",
  "publisher": "gitwithmasum",
  "author": {
    "name": "Masum Billah",
    "url": "https://github.com/gitwithmasum"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "command center",
    "developer dashboard",
    "workspace dashboard",
    "git dashboard",
    "productivity",
    "futuristic",
    "galaxy",
    "vscode"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:galaxyCommandCenter.open",
    "onCommand:galaxyCommandCenter.refresh",
    "onCommand:galaxyCommandCenter.diagnose",
    "onView:galaxyCommandCenter.sidebar"
  ],
  "contributes": {
    "commands": [
      {
        "command": "galaxyCommandCenter.open",
        "title": "Galaxy Command Center: Open Dashboard"
      },
      {
        "command": "galaxyCommandCenter.refresh",
        "title": "Galaxy Command Center: Refresh Status"
      },
      {
        "command": "galaxyCommandCenter.diagnose",
        "title": "Galaxy Command Center: Diagnose"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "galaxyCommandCenter",
          "title": "Galaxy Command Center",
          "icon": "media/command-center.svg"
        }
      ]
    },
    "views": {
      "galaxyCommandCenter": [
        {
          "type": "webview",
          "id": "galaxyCommandCenter.sidebar",
          "name": "Command Center"
        }
      ]
    }
  },
  "scripts": {
    "package": "vsce package",
    "installLocal": "vsce package && code --install-extension masum-galaxy-command-center-1.5.0.vsix --force"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gitwithmasum/VS-Code-Command-Center.git"
  },
  "homepage": "https://github.com/gitwithmasum/VS-Code-Command-Center#readme",
  "bugs": {
    "url": "https://github.com/gitwithmasum/VS-Code-Command-Center/issues"
  }
}
