{
  "name": "masum-galaxy-command-center",
  "displayName": "Masum Galaxy // Command Center",
  "description": "A futuristic VS Code developer command center with Release Center, Project Doctor, Developer Knowledge Graph, safe AI Agent Mode, CI intelligence, task orchestration, architecture intelligence, analytics, Git workflows, and competitive-programming tools.",
  "version": "3.7.0",
  "publisher": "gitwithmasum",
  "author": {
    "name": "Masum Billah",
    "url": "https://github.com/gitwithmasum"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "command center",
    "developer dashboard",
    "workspace dashboard",
    "git dashboard",
    "productivity",
    "futuristic",
    "galaxy",
    "vscode",
    "developer analytics",
    "project intelligence",
    "competitive programming",
    "ai debugging",
    "quality gate",
    "architecture intelligence",
    "dependency graph",
    "workspace search",
    "code navigation",
    "task orchestrator",
    "workflow automation",
    "command graph",
    "npm scripts",
    "ci intelligence",
    "github actions",
    "ready to push",
    "pre push checks",
    "pre push",
    "ai agent",
    "developer agent",
    "safe agent",
    "agentic workflow",
    "developer knowledge graph",
    "code impact",
    "symbol callers",
    "dependency graph navigation",
    "project doctor",
    "project diagnostics",
    "developer health check",
    "release center",
    "release readiness",
    "release management",
    "github release"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:galaxyCommandCenter.open",
    "onCommand:galaxyCommandCenter.refresh",
    "onCommand:galaxyCommandCenter.diagnose",
    "onView:galaxyCommandCenter.sidebar",
    "onCommand:galaxyCommandCenter.customize"
  ],
  "contributes": {
    "commands": [
      {
        "command": "galaxyCommandCenter.open",
        "title": "Galaxy Command Center: Open Dashboard"
      },
      {
        "command": "galaxyCommandCenter.refresh",
        "title": "Galaxy Command Center: Refresh Status"
      },
      {
        "command": "galaxyCommandCenter.diagnose",
        "title": "Galaxy Command Center: Diagnose"
      },
      {
        "command": "galaxyCommandCenter.customize",
        "title": "Galaxy Command Center: Customize Dashboard"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "galaxyCommandCenter",
          "title": "Galaxy Command Center",
          "icon": "media/command-center.svg"
        }
      ]
    },
    "views": {
      "galaxyCommandCenter": [
        {
          "type": "webview",
          "id": "galaxyCommandCenter.sidebar",
          "name": "Command Center"
        }
      ]
    }
  },
  "scripts": {
    "check": "node --check extension.js && node --check src/core/workspace.js && node --check src/core/git.js && node --check src/core/process.js && node --check src/features/cp-core.js && node --check src/features/cp.js && node --check src/features/quality.js && node --check src/features/analytics.js && node --check src/features/architecture.js && node --check src/features/orchestrator.js && node --check src/features/ci.js && node --check src/features/agent.js && node --check src/features/knowledge-graph.js && node --check src/features/project-doctor.js && node --check src/features/release-center.js && node --check test/quality.test.js && node --check test/orchestrator.test.js && node --check test/architecture.test.js && node --check test/cp-core.test.js && node --check test/ci.test.js && node --check test/agent.test.js && node --check test/knowledge-graph.test.js && node --check test/project-doctor.test.js && node --check test/release-center.test.js",
    "vscode:prepublish": "npm run check && npm test",
    "package": "vsce package",
    "installLocal": "vsce package && code --install-extension masum-galaxy-command-center-3.7.0.vsix --force",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gitwithmasum/VS-Code-Command-Center.git"
  },
  "homepage": "https://github.com/gitwithmasum/VS-Code-Command-Center#readme",
  "bugs": {
    "url": "https://github.com/gitwithmasum/VS-Code-Command-Center/issues"
  }
}
